# ============================================================
# DevOps Infrastructure — Example .env (.env.example)
# Copy file ini menjadi .env dan sesuaikan nilainya sebelum setup.
# ============================================================

# ── 1. Global Runtime & Environment ────────────────────────
DOMAIN=faisalaffan.com
TIMEZONE=Asia/Jakarta
ENVIRONMENT=development

# ── 2. Git & Repository ────────────────────────────────────
GIT_EMAIL=faisallionel@gmail.com
GIT_NAME="Faisal Affan"
GIT_REPO=git@github.com:faisalaffan/infra-light.git
GIT_BRANCH=dev
INFRA_DIR=/opt/infra-light

# ── 3. SSH & Host Access ───────────────────────────────────
SSH_KEY_TYPE=rsa
SSH_KEY_BITS=4096
SSH_KEY_PATH=$HOME/.ssh/id_rsa
SSH_PUBLIC_KEY="your_ssh_public_key_here"

# ── 4. Network, Subnets & CIDRs ────────────────────────────
NODE_PUBLIC_IP=139.0.15.90
NODE_PUBLIC_SUBNET=139.0.15.88/29
TAILSCALE_SUBNET=100.64.0.0/10
K3S_POD_CIDR=10.42.0.0/16
K3S_SERVICE_CIDR=10.43.0.0/16

# ── 5. K3s Kubernetes Engine & Default Resources ───────────
K3S_TOKEN=k3s-local-dev-token-2026
K3S_VERSION=v1.31.5+k3s1
K3S_FLANNEL_IFACE=tailscale0
K3S_DISABLE_COMPONENTS=traefik,servicelb
K8S_REQUESTS_MEMORY=128Mi
K8S_REQUESTS_CPU=100m
K8S_LIMITS_MEMORY=512Mi
K8S_LIMITS_CPU=500m

# ── 6. Ingress NGINX & SSL/TLS ─────────────────────────────
INGRESS_NGINX_VERSION=4.12.1
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443
INGRESS_PROXY_BODY_SIZE=0
INGRESS_PROXY_BUFFER_SIZE=16k
INGRESS_CLIENT_MAX_BODY_SIZE=100m
CERT_MANAGER_VERSION=v1.17.1
LETSENCRYPT_EMAIL=faisallionel@gmail.com

# ── 7. Edge Tunnels & Mesh Networking (Cloudflare / Tailscale) ──
CF_TUNNEL_MODE=token
CF_TUNNEL_TOKEN=eyJhIjoi...your-tunnel-token-here...
TAILSCALE_VERSION=stable
TAILSCALE_AUTHKEY=skip-tailscale-local
TAILSCALE_ARGS=--accept-routes
# Tailscale OAuth (create at tailscale.com → Settings → OAuth)
# Scopes: General.Services(r/w) + Devices.Core(r/w) + Keys.AuthKeys(r/w)
# Tags: tag:k8s-operator
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=

# ── 8. Edge Security & Ingress Basic Auth ──────────────────
# NGINX Ingress Basic Auth protection for platforms without native login:
# - Docker Registry UI (registry.faisalaffan.com)
# - Redpanda Console (redpanda.faisalaffan.com)
# - NATS Monitoring (nats.faisalaffan.com)
INFRA_BASIC_AUTH_USER=admin
INFRA_BASIC_AUTH_PASSWORD=infra_admin_secret_2026!

# ── 9. Primary Relational Database (PostgreSQL) ────────────
PG_VERSION=17
PG_IMAGE=postgres-all:latest
PG_CONTAINER_NAME=postgres-all
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres_super_secret_2026
PG_DATABASE=postgres
PG_APP_USER=appuser
PG_APP_PASSWORD=appuser_secret_2026
PG_APP_DB=appdb
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=64MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=500
PG_MEMORY_LIMIT=4G
PG_MEMORY_RESERVATION=512M
PG_DATA_SIZE=20Gi

# ── 10. Document Database (MongoDB & Mongo Express) ────────
MONGODB_VERSION=8.0
MONGODB_ROOT_PASSWORD=mongo_root_secret_2026
MONGODB_MEMORY_LIMIT=1G
MONGODB_DATA_SIZE=5Gi
MONGO_UI_HOSTNAME=mongo.faisalaffan.com
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=mongo_admin_secret_2026!

# ── 11. In-Memory Cache (Redis & Redis Commander) ──────────
REDIS_UI_HOSTNAME=redis-ui.faisalaffan.com
REDIS_COMMANDER_CHART_VERSION=0.1.16
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=redis_admin_secret_2026!

# ── 12. Object Storage (MinIO S3) ──────────────────────────
MINIO_CONSOLE_HOSTNAME=minio.faisalaffan.com
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_HOSTNAME=s3.faisalaffan.com

# ── 13. Event Streaming & Messaging (NATS, EMQX, Redpanda) ──
# ── NATS (IoT & Internal PubSub) ──
NATS_VERSION=2.11
NATS_MEMORY_LIMIT=256Mi
NATS_DATA_SIZE=2Gi
NATS_UI_HOSTNAME=nats.faisalaffan.com

# ── EMQX (MQTT Broker) ──
EMQX_VERSION=5.8
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=emqx_dashboard_secret_2026
EMQX_MEMORY_LIMIT=1G
EMQX_DATA_SIZE=2Gi
EMQX_DASHBOARD_HOSTNAME=emqx.faisalaffan.com

# ── Redpanda (Kafka-compatible Streaming Platform) ──
REDPANDA_VERSION=26.2.2
REDPANDA_REPLICAS=1
REDPANDA_CPU_LIMIT=1
REDPANDA_MEMORY_REQUEST=1Gi
REDPANDA_MEMORY_LIMIT=3Gi
REDPANDA_DATA_SIZE=20Gi
REDPANDA_CONSOLE_HOSTNAME=redpanda.faisalaffan.com

# ── 14. Identity, Access & Secrets Management (ZITADEL & Vault) ──
# ── ZITADEL (IAM, OIDC & OAuth2) ──
ZITADEL_CHART_VERSION=10.4.0
ZITADEL_VERSION=v4.19.2
ZITADEL_HOSTNAME=zitadel.faisalaffan.com
ZITADEL_ORG_NAME="Faisal Affan"
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_EMAIL=admin@faisalaffan.com
ZITADEL_ADMIN_PASSWORD=generate_admin_strong_password
ZITADEL_MASTERKEY=generate_with_openssl_rand_hex_16_or_32_chars
ZITADEL_CPU_REQUEST=100m
ZITADEL_CPU_LIMIT=1
ZITADEL_MEMORY_REQUEST=256Mi
ZITADEL_MEMORY_LIMIT=1Gi

# ── HashiCorp Vault ──
VAULT_CHART_VERSION=0.29.1
VAULT_VERSION=1.18.4
VAULT_MEMORY_LIMIT=512Mi
VAULT_DATA_SIZE=5Gi
VAULT_UI_HOSTNAME=vault.faisalaffan.com

# ── 15. Observability Stack (Grafana LGTM & Profiling) ─────
# ── Grafana ──
GRAFANA_DOMAIN=grafana.faisalaffan.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secret_2026
GRAFANA_PORT=3000
GRAFANA_PLUGINS=grafana-pyroscope-app
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ANONYMOUS_ROLE=Admin
GRAFANA_FEATURE_TOGGLES=accessControlOnCall,traceToMetrics,traceToProfiles,traceQLStreaming,correlations
GRAFANA_DATA_SIZE=5Gi

# ── VictoriaMetrics (Metrics) ──
VM_PORT=8428
VM_RETENTION=30d
VM_DATA_SIZE=10Gi

# ── Loki (Logs) ──
LOKI_PORT=3100
LOKI_RETENTION=30d
LOKI_DATA_SIZE=10Gi

# ── Tempo (Traces) ──
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_RETENTION=24h
TEMPO_DATA_SIZE=10Gi

# ── Pyroscope (Continuous Profiling) ──
PYROSCOPE_PORT=4040
PYROSCOPE_RETENTION=720h
PYROSCOPE_DATA_SIZE=5Gi

# ── Grafana Alloy (Telemetry Collector) ──
ALLOY_PORT=12345
ALLOY_LOKI_RECEIVER_PORT=3500

# ── 16. AI & LLM Infrastructure (Qdrant & Arize Phoenix) ───
# ── Qdrant (AI Vector Database) ──
QDRANT_VERSION=v1.13.4
QDRANT_API_KEY=qdrant_admin_secret_2026
QDRANT_MEMORY_REQUEST=512Mi
QDRANT_MEMORY_LIMIT=4Gi
QDRANT_CPU_REQUEST=200m
QDRANT_CPU_LIMIT=2
QDRANT_DATA_SIZE=20Gi
QDRANT_UI_HOSTNAME=qdrant.faisalaffan.com

# ── Arize Phoenix (AI Observability, Evals & Tracing) ──
PHOENIX_VERSION=latest
PHOENIX_HOSTNAME=phoenix.faisalaffan.com
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317
PHOENIX_WORKING_DIR=/data
PHOENIX_DATA_SIZE=10Gi
PHOENIX_ENABLE_AUTH=True
PHOENIX_USE_SECURE_COOKIES=True
PHOENIX_SECRET=generate_with_openssl_rand_hex_32
PHOENIX_ADMIN_SECRET=generate_with_openssl_rand_hex_32_with_digit_and_letter
PHOENIX_ADMIN_PASSWORD=generate_admin_strong_password
PHOENIX_ADMINS="admin=admin@faisalaffan.com"
PHOENIX_MEMORY_REQUEST=512Mi
PHOENIX_MEMORY_LIMIT=2Gi
PHOENIX_CPU_REQUEST=250m
PHOENIX_CPU_LIMIT=2

# ── 17. Developer Tools & Web UIs ──────────────────────────
# ── Mailpit (Email Testing & SMTP Relay) ──
MAILPIT_DATA_SIZE=2Gi
MAILPIT_MAX_MESSAGES=5000
MAILPIT_UI_HOSTNAME=mailpit.faisalaffan.com
MAILPIT_UI_USER=admin
MAILPIT_UI_PASSWORD=mailpit_secret_2026!
MAILPIT_SMTP_RELAY_HOST=
MAILPIT_SMTP_RELAY_PORT=587
MAILPIT_SMTP_RELAY_USERNAME=
MAILPIT_SMTP_RELAY_PASSWORD=
MAILPIT_SMTP_RELAY_AUTH=plain
MAILPIT_SMTP_RELAY_STARTTLS=true

# ── CloudBeaver (Universal Database Manager) ──
CLOUDBEAVER_HOSTNAME=db.faisalaffan.com

# ── Private Docker Registry & UI ──
REGISTRY_DATA_SIZE=20Gi
REGISTRY_UI_HOSTNAME=registry.faisalaffan.com

# ── Excalidraw (Virtual Whiteboard) ──
EXCALIDRAW_HOSTNAME=excalidraw.faisalaffan.com

# ── MCP Toolbox ──
TOOLBOX_VERSION=1.4.0

# ── 18. CI/CD & Automation (Woodpecker CI & GitLab Runner) ──
# ── Woodpecker CI (GitHub OAuth) ──
WOODPECKER_VERSION=3.17.0
WOODPECKER_SERVER_HOST=ci.faisalaffan.com
WOODPECKER_SERVER_PORT=8000
WOODPECKER_DB_HOST=postgres.infra.svc.cluster.local
WOODPECKER_DB_PORT=5432
WOODPECKER_DB_NAME=woodpecker
WOODPECKER_DB_USER=postgres
WOODPECKER_DB_PASSWORD=postgres_super_secret_2026
WOODPECKER_AGENT_SECRET=wp_agent_secret_2026
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_ADMIN_USER=admin
WOODPECKER_DATA_SIZE=10Gi

# ── GitLab Runner ──
GITLAB_URL=https://gitlab.com
GITLAB_RUNNER_AUTH_TOKEN=
GITLAB_RUNNER_TAGS="k3s,devops,linux"
GITLAB_RUNNER_CONCURRENT=10
GITLAB_RUNNER_CPU_REQUEST=500m
GITLAB_RUNNER_CPU_LIMIT=4
GITLAB_RUNNER_MEMORY_REQUEST=512Mi
GITLAB_RUNNER_MEMORY_LIMIT=2Gi

# ── 19. Application Workspaces ─────────────────────────────
# ── Resolva (Reconciliation Platform) ──
RESOLVA_API_HOSTNAME=resolva-api.faisalaffan.com
RESOLVA_FRONTEND_HOSTNAME=resolva.faisalaffan.com

# ── GeoStack ──
GEOSTACK_POSTGRES_PASSWORD=geostack_dev_secret_2026
GEOSTACK_JWT_SECRET=geostack_jwt_secret_2026

# ── 20. Disaster Recovery (DR) & Backup Infrastructure ─────
# ── Failover Runtime ──
FAILOVER_PROVIDER=tencent
FAILOVER_ENV=drill
FAILOVER_K3S_VERSION=v1.30.2+k3s1
FAILOVER_DOMAIN=homelab.faisalaffan.com

# ── Backblaze B2 (Offsite S3 Snapshots) ──
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET=my-homelab-k3s-backups
B2_PREFIX=k3s-snapshots
B2_APPLICATION_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here

# ── Restic (Client-Side Encrypted PV Backup) ──
RESTIC_PASSWORD=generate_with_openssl_rand_base64_32
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/my-homelab-k3s-backups/restic-pvs
RESTIC_BACKUP_SCHEDULE="0 */6 * * *"
RESTIC_RETENTION_KEEP_DAILY=7
RESTIC_RETENTION_KEEP_WEEKLY=4
RESTIC_RETENTION_KEEP_MONTHLY=3
RESTIC_EXCLUDE_REGISTRY=true

# ── Cloudflare DNS Failover & Master Pointer ──
CLOUDFLARE_EMAIL=faisallionel@gmail.com
CLOUDFLARE_API_KEY=your_global_api_key_here
CLOUDFLARE_ZONE_ID=your_cf_zone_id_here
CLOUDFLARE_ACCOUNT_ID=your_cf_account_id_here
CLOUDFLARE_HOMELAB_TUNNEL_UUID=your_homelab_tunnel_uuid_here
CLOUDFLARE_TENCENT_TUNNEL_UUID=your_tencent_tunnel_uuid_here
CLOUDFLARE_STANDBY_TUNNEL_TOKEN=your_standby_tunnel_token_here
CLOUDFLARE_MASTER_ORIGIN_RECORD=origin.homelab.faisalaffan.com

# ── Tencent Cloud (Cold-Standby DR Provider) ──
TENCENTCLOUD_SECRET_ID=your_tencent_secret_id_here
TENCENTCLOUD_SECRET_KEY=your_tencent_secret_key_here
TENCENTCLOUD_REGION=ap-singapore
TENCENTCLOUD_ZONE=ap-singapore-2
TENCENT_PROD_INSTANCE_TYPE=SA5.4XLARGE64
TENCENT_DRILL_INSTANCE_TYPE=SA5.LARGE8
TENCENT_INSTANCE_ID=

# ── GitHub PAT (Workflow Sentinel & Dispatch) ──
GITHUB_PAT=

# ── Vultr Cloud (Secondary Standby Provider) ──
VULTR_API_KEY=your_vultr_api_key_here
VULTR_REGION=sgp
VULTR_PROD_PLAN=vc2-16c-64gb
VULTR_DRILL_PLAN=vhf-4c-16gb
