# ==============================================================================
# Failover Drill Environment Configuration Example
# Copy this file to terraform.tfvars and fill in your details
# ==============================================================================

aws_region      = "ap-southeast-3" # Jakarta (or ap-southeast-1 for Singapore)
instance_type   = "t3.xlarge"      # Lean sizing for drill test cost-efficiency
root_volume_size = 50

# Target K3s version matching baremetal
k3s_version     = "v1.30.2+k3s1"

# Backblaze B2 S3-compatible snapshot credentials
b2_endpoint        = "https://s3.us-west-004.backblazeb2.com"
b2_bucket          = "my-homelab-k3s-backups"
b2_prefix          = "k3s-snapshots"
b2_key_id          = "YOUR_B2_APPLICATION_KEY_ID"
b2_application_key = "YOUR_B2_APPLICATION_KEY"

# Optional GitOps repo to pull latest manifests
gitops_repo_url = "https://github.com/your-user/your-devops-repo.git"
gitops_branch   = "main"

# DNS switch for drill (isolate from production)
dns_provider       = "none" # Set to "cloudflare" if testing drill subdomain
enable_dns_switch  = false
drill_record_name  = "drill.homelab.example.com"
