# ============================================================
# PostgreSQL Configuration
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=postgres

# Application database (created at init)
APP_DB=appdb
APP_USER=appuser
APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD

# ============================================================
# Container Settings
# ============================================================
CONTAINER_NAME=postgres-all
POSTGRES_PORT=5432
DATA_DIR=./data
