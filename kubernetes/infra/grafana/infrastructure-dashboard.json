    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🖥️ Host Baremetal & Hardware Server Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15 },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 101,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "Host CPU %",
          "refId": "A"
        },
        {
          "expr": "node_load1",
          "legendFormat": "Load 1m",
          "refId": "B"
        },
        {
          "expr": "node_load5",
          "legendFormat": "Load 5m",
          "refId": "C"
        }
      ],
      "title": "Host CPU % & System Load Average",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "description": "Total Host RAM vs Used vs Available",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 24000000000 },
              { "color": "red", "value": 30000000000 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 102,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used RAM",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available RAM",
          "refId": "B"
        },
        {
          "expr": "node_memory_Cached_bytes + node_memory_Buffers_bytes",
          "legendFormat": "Cached/Buffers",
          "refId": "C"
        }
      ],
      "title": "Host RAM Memory Usage (Total / Used / Avail)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "description": "Host physical LVM root filesystem (455Gi total)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 488420507648,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 366315380736 },
              { "color": "red", "value": 439578456883 }
            ]
          },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 103,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_free_bytes{mountpoint=\"/\"}",
          "legendFormat": "Terpakai (Root /)",
          "refId": "A"
        },
        {
          "expr": "node_filesystem_free_bytes{mountpoint=\"/\"}",
          "legendFormat": "Sisa Kapasitas (Free)",
          "refId": "B"
        }
      ],
      "title": "Host Root Disk (LVM 455GiB): Terpakai vs Sisa",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Uptime" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 104,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false }
      },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        },
        {
          "expr": "sum(rate(node_network_receive_bytes_total{device=~\"enp.*|tailscale0\"}[2m])) * 8",
          "legendFormat": "Network Rx (In)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total{device=~\"enp.*|tailscale0\"}[2m])) * 8",
          "legendFormat": "Network Tx (Out)",
          "refId": "C"
        }
      ],
      "title": "Server Uptime & Physical Network",
      "type": "stat"
    },
